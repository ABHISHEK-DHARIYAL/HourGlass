{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/quote", "function": "quote" },
      { "source": "/api/debug-log", "function": "debugLog" },
      { "source": "/api/smart-reminders", "function": "smartReminders" },
      { "source": "/api/sync-tasks", "function": "syncTasks" },
      { "source": "/api/notification-settings", "function": "notificationSettings" },
      { "source": "/api/clear-fcm-token", "function": "clearFcmToken" },
      { "source": "/api/delete-account", "function": "deleteAccount" },
      { "source": "/api/coach/**", "function": "coachApi" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [{ "key": "Service-Worker-Allowed", "value": "/" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "auth": { "port": 9099 },
    "ui": { "enabled": true }
  }
}
