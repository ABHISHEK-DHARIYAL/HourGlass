# AI Coach backend config. Copy to functions/.env (git-ignored) and fill in.
# `firebase deploy --only functions` uploads these automatically; the emulator reads them too.

# REQUIRED — Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — any current Gemini model id from AI Studio (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional — max AI requests per user per day (default 80)
COACH_DAILY_LIMIT=80

# Optional — email alerts (schedule email + daily digest). Leave blank to disable.
# Gmail example: host smtp.gmail.com, port 465, user = your Gmail, pass = a Google App Password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="HourGlass Coach <you@gmail.com>"
